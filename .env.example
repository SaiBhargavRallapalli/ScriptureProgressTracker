# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real keys.

# YouTube Data API v3 key, restricted to that API only, from a Google
# Cloud project. Used server-side only (app/api/youtube/*/route.ts) — it
# must never be exposed to the browser, so don't rename this with a
# NEXT_PUBLIC_ prefix.
YOUTUBE_API_KEY=

# Vercel Blob read/write token (Phase 4) — from the Vercel dashboard's
# Storage tab after connecting a Blob store. Server-side only
# (app/api/blob/*, app/api/pdf-search/save).
BLOB_READ_WRITE_TOKEN=

# Neon Postgres connection string (Phase 6/7), from the Vercel Marketplace
# Neon integration's "Quickstart" panel — use the pooled DATABASE_URL,
# not the *_UNPOOLED/PG*/POSTGRES_* variants. Server-side only
# (lib/syncDb.ts, lib/auth/authDb.ts).
DATABASE_URL=

# Phase 7: signs/verifies session cookies (lib/auth/session.ts). Not
# issued by any external service — generate your own long random string
# (e.g. `openssl rand -base64 32`). Rotating this logs every account out
# at once (sessions are stateless JWTs, no server-side revocation list).
SESSION_SECRET=

# Phase 7: invite code required to create a new account (lib/auth/actions.ts's
# signup()). All accounts on one deployment share its YouTube/Blob/Postgres
# resources with no per-user billing, so signup is gated rather than open.
# Generate your own (e.g. `openssl rand -hex 16`) and share it only with
# people you want able to sign up.
SIGNUP_CODE=

# Phase 7, optional and one-time: the email of the account allowed to call
# POST /api/admin/claim-legacy-data, which assigns a pre-accounts
# deployment's existing "ownerless" rows to that account. Set it, sign up
# with that exact email, call the route once, then unset it.
LEGACY_ADMIN_EMAIL=
